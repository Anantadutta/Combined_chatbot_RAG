# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# Required for real answers. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional - defaults shown
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768
# RERANKER=local            # local | gemini | none
# TOP_K=6                   # chunks sent to the LLM
# CANDIDATE_K=20            # candidates per retriever before fusion

# Vector DB: local folder by default (data/index/qdrant).
# For cloud deployment, point at Qdrant Cloud / a Qdrant server instead:
# QDRANT_URL=
# QDRANT_API_KEY=

# Web server (python -m app.cli serve)
# ADMIN_TOKEN=              # if set, upload/update/delete/reindex need header X-Admin-Token
# UPLOADS_DIR=              # where uploaded files are kept (default data/uploads)
# REWRITE_FOLLOW_UPS=true   # rewrite chat follow-ups ("what about 2025?") into standalone questions
